---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

const { title = "Gospel Stories", description } = Astro.props;
const pageTitle = title === "Gospel Stories" ? title : `${title} | Gospel Stories`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? "Illustrated scripture stories for children."} />
    <link rel="preconnect" href="https://www.churchofjesuschrist.org" />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
