---
import Base from "../../../layouts/Base.astro";
import { getSlidePath, getStories } from "../../../lib/stories.js";

export async function getStaticPaths() {
  const stories = await getStories();

  return stories.flatMap((story, storyIndex) =>
    story.slides.map((slide, index) => ({
      params: {
        book: story.book,
        story: story.slug,
        slide: String(index + 1).padStart(2, "0"),
      },
      props: {
        nextStory: stories[storyIndex + 1],
        slide,
        slideNumber: index + 1,
        story,
        totalSlides: story.slides.length,
      },
    })),
  );
}

const { nextStory, slide, slideNumber, story, totalSlides } = Astro.props;
const previousHref = slideNumber === 1 ? "/" : getSlidePath(story, slideNumber - 1);
const isFinalSlide = slideNumber === totalSlides;
const nextHref = isFinalSlide
  ? nextStory && getSlidePath(nextStory, 1)
  : getSlidePath(story, slideNumber + 1);
const nextSlide = isFinalSlide ? nextStory?.slides[0] : story.slides[slideNumber];
---

<Base title={story.title} description={story.description}>
  <main class="story-page" data-slide-navigation>
    <header class="story-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a class="brand" href="/">Stories for Young Readers</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="story-context">{story.bookTitle}</span>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <h1 class="story-title" aria-current="page">{story.title}</h1>
        {story.videoUrl && (
          <>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <a
              class="story-video-icon"
              href={story.videoUrl}
              target="_blank"
              rel="noreferrer"
              aria-label={`Watch video for ${story.title}`}
              title="Watch video"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3Z" />
                <path d="m6.2 5.3 3.1 3.9" />
                <path d="m12.4 3.4 3.1 4" />
                <path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
              </svg>
            </a>
          </>
        )}
      </nav>
      <span class="slide-number">{String(slideNumber).padStart(2, "0")} / {String(totalSlides).padStart(2, "0")}</span>
    </header>

    <section class="slide" aria-label={`Slide ${slideNumber}`} transition:animate="fade">
      <div class={`slide-images${slide.images.length > 1 ? " slide-images--gallery" : ""}`}>
        {slide.images.map((image, index) => (
          <img
            src={image.src}
            alt={image.alt || story.title}
            loading="eager"
            fetchpriority={index === 0 ? "high" : "auto"}
            decoding="async"
          />
        ))}
      </div>
      <article class="slide-copy">
        {slide.html && <div class="prose" set:html={slide.html}></div>}
      </article>
    </section>

    <nav class="slide-nav" aria-label="Slide navigation">
      <a data-slide-previous href={previousHref}>{slideNumber === 1 ? "All stories" : "Previous"}</a>
      <span>{story.title}</span>
      {nextHref ? <a data-slide-next data-astro-prefetch="load" href={nextHref}>{isFinalSlide ? "Next story" : "Next"}</a> : <span>End</span>}
    </nav>

    {nextSlide && (
      <template data-next-slide-images>
        {nextSlide.images.map((image) => (
          <img src={image.src} alt="" />
        ))}
      </template>
    )}
  </main>
</Base>

<script>
  import { setupSlideNavigation } from "../../../scripts/slide-navigation.js";

  document.addEventListener("astro:page-load", setupSlideNavigation);
  setupSlideNavigation();
</script>
