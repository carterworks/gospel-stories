---
import Base from "../layouts/Base.astro";
import { getCollections, getSlidePath } from "../lib/stories.js";

const collections = await getCollections();
const buildTime = new Date();
const formattedBuildTime = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
}).format(buildTime);
---

<Base>
  <main class="index-page">
    <header class="index-intro">
      <h1>Gospel Stories</h1>
      <p>Choose a story to begin.</p>
    </header>

    {collections.map((collection) => (
      <section class="collection">
        <h2>{collection.title}</h2>
        <div class="book-list">
          {collection.books.map((book) => (
            <section class="book" aria-labelledby={`${book.slug}-title`}>
              <h3 id={`${book.slug}-title`}>{book.title}</h3>
              <ol>
                {book.stories.map((story) => (
                  <li>
                    <a href={getSlidePath(story, 1)}>{story.title}</a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </section>
    ))}
  </main>
  <footer class="site-footer">
    <p>Built <time datetime={buildTime.toISOString()}>{formattedBuildTime} UTC</time></p>
  </footer>
</Base>
